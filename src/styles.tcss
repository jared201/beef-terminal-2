Placeholder {
    height: 100%;
}


#top {
    height: 50%;
    width: 100%;
    layout: grid;
    grid-size: 2 2;
}
#vertical-layout {
    height: 100%;
    width: 50%;
    layout: grid;
    grid-size: 1 3;
}
#vertical-layout > * {
    height: 33%;  /* Adjust the height as needed */
}

#left {
    row-span: 2;
}

#bot {
    height: 50%;
    width: 100%;
    layout: grid;
    grid-size: 8 8;
}

#c1 {
    row-span: 4;
    column-span: 8;
    height: 100%;
}

#col1, #col2, #col3 {
    width: 1fr;
}

#p1 {
    row-span: 4;
    column-span: 4;
}

#p2 {
    row-span: 2;
    column-span: 4;
}

#p3 {
    row-span: 2;
    column-span: 2;
}

#p4 {
    row-span: 1;
    column-span: 2;
}
#row1, #row2, #row3, #row4, #row5, #row6, #row7, #row8 {
    height: 1fr;
}
#right-container {
    width: 20%;  /* Adjust the width as needed */
}