/* styles.tcss */
Placeholder {
    height: 100%;
}

#vertical-layout {
    height: 100%;
    width: 70%;  /* Adjust the width as needed */
    layout: grid;
    grid-size: 1 3;
}

#vertical-layout > * {
    height: 33%;  /* Adjust the height as needed */
}

#right-container {
    width: 30%;  /* Adjust the width as needed */
    height: 100%;
    layout: grid;
    grid-size: 1 3;  /* Ensure the placeholders are arranged in a single column */
}

#right-container > * {
    height: 33%;  /* Adjust the height as needed */
}